//Portraits

COPY ~InLoveUndeath/portraits~     override

//Areas

COPY ~InLoveUndeath/areas~     override

COPY_EXISTING ar1106.are override // buried book
 LPF fj_are_structure INT_VAR
    fj_type = 8 //nonvisible
    fj_box_left = 505
    fj_box_top = 716
    fj_box_right = 526
    fj_box_bottom = 728
    fj_loc_x = 533
    fj_loc_y = 742
    fj_flags = 0
     fj_vertex_0 = 505 + (724 << 16)
     fj_vertex_1 = 516 + (720 << 16)
     fj_vertex_2 = 525 + (716 << 16)
     fj_vertex_3 = 526 + (727 << 16)
     fj_vertex_4 = 517 + (728 << 16)
   STR_VAR
    fj_structure_type = container
    fj_name = l#xzeb
    fj_trap_script = ~l#xzeb~
 END
 
 COPY_EXISTING ~AR0206.are~ ~override~
      WRITE_ASCII 0x94 ~AR0206~ #8 

