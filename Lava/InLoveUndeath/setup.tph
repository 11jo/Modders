COPY_EXISTING ~SPWI218.spl~ ~override/L#XZUP1.spl~
SAY NAME1 @177
WRITE_SHORT 0x1C 4
WRITE_LONG 0x34 1
READ_LONG 0x64 "offset_abil"
READ_SHORT 0x68 "num_abil"
READ_ASCII ("%offset_abil%" + 0x04) "bam"
WRITE_EVALUATED_ASCII 0x3A "%bam%"
WHILE (0 < "%num_abil%")
BEGIN
WRITE_SHORT (("%offset_abil%" + 0x02) + (("%num_abil%" - 1) * 0x28)) 4
SET "num_abil" = ("%num_abil%" - 1)
END

COPY_EXISTING ~SPPR608.spl~ ~override/L#XZUP2.spl~
SAY NAME1 @178
WRITE_SHORT 0x1C 4
WRITE_LONG 0x34 1
READ_LONG 0x64 "offset_abil"
READ_SHORT 0x68 "num_abil"
READ_ASCII ("%offset_abil%" + 0x04) "bam"
WRITE_EVALUATED_ASCII 0x3A "%bam%"
WHILE (0 < "%num_abil%")
BEGIN
WRITE_SHORT (("%offset_abil%" + 0x02) + (("%num_abil%" - 1) * 0x28)) 4
SET "num_abil" = ("%num_abil%" - 1)
END

