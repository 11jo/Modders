SAY NAME1 @14
SAY NAME2 @14
SAY DESC @15
LPF CLONE_EFFECT INT_VAR match_opcode = 40 opcode = 142 parameter2 = 41 END // missing slow icon
LPF CLONE_EFFECT INT_VAR match_opcode = 24 opcode = 142 parameter2 = 36 END // missing panic icon


COPY ~Varshoon\ITM\VxW2.itm~ ~override~
SAY NAME1 @16
SAY NAME2 @16
SAY DESC @17
LPF ALTER_EFFECT INT_VAR match_opcode = 142 match_parameter2 = 89 parameter2 = 86 END // Typo
LPF CLONE_EFFECT INT_VAR match_opcode = 24 opcode = 142 parameter2 = 36 END // missing panic icon

