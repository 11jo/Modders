ACTION_IF GAME_IS "bg2ee eet" BEGIN
 OUTER_SET spec_lcase = RESOLVE_STR_REF(~mind flayer~)
 OUTER_SET spec_ucase = RESOLVE_STR_REF(~Mind Flayer~)
 APPEND ~racetext.2da~ ~MIND_FLAYER   124        %spec_lcase%       -1         %spec_ucase%          -1~ UNLESS ~MIND_FLAYER~
END 


