COPY ~Varshoon\ITM\VxGit.itm~ ~override~
SAY NAME1 @26
SAY NAME2 @26
SAY DESC @27

ACTION_IF NOT FILE_EXISTS_IN_GAME ~neera10.cre~ THEN BEGIN
COPY ~Varshoon\ITM\VxGift.itm~ ~override~ // modified item to work like other protection against sleep and berserk (ie. Greenstone Amulet) 
SAY NAME1 @28
SAY NAME2 @28
SAY DESC @29
LPF DELETE_EFFECT INT_VAR match_opcode = 2 END // delete cure sleep
LPF DELETE_EFFECT INT_VAR match_opcode = 4 END // delete cure berserk
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 parameter2 = 39 target = 1 timing = 2 END // immunity to sleep opcode
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 169 parameter2 = 14 target = 1 timing = 2 END // prevent portrait icon: sleep
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 parameter2 = 217 target = 1 timing = 2 END // immunity to power word sleep opcode
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 101 parameter2 = 3 target = 1 timing = 2 END // immunity to berserk opcode
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 169 parameter2 = 4 target = 1 timing = 2 END // prevent portrait icon: berserk
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 STR_VAR resource = "spwi116" END // protect against sleep
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 STR_VAR resource = "spwi220" END // protect against power word sleep
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 142 parameter2 = 52 target = 1 timing = 2 END // missing icon ; add mind shield
PATCH_IF ((MOD_IS_INSTALLED ITEM_REV.tp2 0) OR (MOD_IS_INSTALLED SPELL_REV.tp2 0)) BEGIN
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 STR_VAR resource = "DVSLEEP" END // protect against sleep
LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 206 target = 1 timing = 2 STR_VAR resource = "WAND08" END // protect against sleep
END
PATCH_IF MOD_IS_INSTALLED 1PP.tp2 208 BEGIN
  WRITE_ASCII 0x22 ~JB~ #2		   // 1pp circlet band icon (JB)
  WRITE_ASCII 0x44 ~GAMUL02~ #8    // amulet ground icon
  LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 7 parameter1 = 45 parameter2 = 52 target = 1 timing = 2 END
END
END

ACTION_IF FILE_EXISTS_IN_GAME ~neera10.cre~ THEN BEGIN
COPY ~Varshoon\EEITM\VxGift.itm~ ~override~ // modified item to work like other protection against sleep and berserk (ie. Greenstone Amulet) 
SAY NAME1 @28
SAY NAME2 @28
SAY DESC @29
END

