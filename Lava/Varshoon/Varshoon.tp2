/* ------------- *
* Fate Spirit *
* ------------- */
ACTION_IF GAME_IS "eet" BEGIN
INCLUDE ~EET/other/EET_functions.tph~ // functions from EET mod
LAF ~EET_NPC_TRANSITION~
INT_VAR
type = 2 // NPC is summon-able if met before
default_ToB = 1
 clean_ToB = 1
STR_VAR
dv = "VxVar" // death variable of your NPC
override_SoA = "VxVar" // override script of your NPC (SoA)
override_ToB = "VxVar25" // override script of your NPC (ToB)
cre_ToB = "vxvar25"
dialog_ToB = "VXVAR25" // joining dialogue for ToB
traFile = EVAL "Varshoon/Languages/%LANGUAGE%/FateSpirit.tra"
string = "@0"
stringPosDV = "Viconia" 
clean_ToB_DV = "VxVar"
END
END ELSE BEGIN
COMPILE ~Varshoon/DIALOGUES/FateSpirit.d~ USING ~Varshoon/Languages/%LANGUAGE%/FateSpirit.tra~
END

EXTEND_TOP   ~AR0516.bcs~ ~Varshoon\SCRIPTS\AR0516.baf~
EXTEND_TOP   ~AR0711.bcs~ ~Varshoon\SCRIPTS\AR0711.baf~
EXTEND_TOP   ~AR6200.bcs~ ~Varshoon\SCRIPTS\AR6200.baf~

